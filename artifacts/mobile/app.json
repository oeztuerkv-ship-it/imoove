{
  "expo": {
    "name": "ONRODA",
    "owner": "oeztuerkv-ship-it",
    "slug": "mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "onroda",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/onroda-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vedat.mobile",
      "buildNumber": "29",
      "infoPlist": {
        "CFBundleDisplayName": "ONRODA",
        "NSCameraUsageDescription": "ONRODA nutzt die Kamera zum Scannen von Transportscheinen und Fahrt-QR-Codes.",
        "NSLocationWhenInUseUsageDescription": "ONRODA benötigt deinen Standort für die aktuelle Fahrt.",
        "NSLocationAlwaysUsageDescription": "ONRODA benötigt deinen Standort während aktiver Fahrten, auch im Hintergrund.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "ONRODA benötigt deinen Standort, um Fahrten zu vermitteln.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "onroda"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.683656628383-s837b4fhbbrbks1thoqq56ilksg9cdjr"
            ]
          }
        ],
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "GMSApiKey": "AIzaSyC6-pFE0kCcB-57r2ALZ81SAXys8_PpeoQ"
      },
      "config": {
        "googleMapsApiKey": "AIzaSyC6-pFE0kCcB-57r2ALZ81SAXys8_PpeoQ"
      }
    },
    "android": {
      "package": "com.vedat.Onroda",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC6-pFE0kCcB-57r2ALZ81SAXys8_PpeoQ"
        }
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/onroda-splash.png",
          "imageWidth": 280,
          "resizeMode": "contain"
        }
      ],
      "expo-router",
      "expo-font",
      "expo-notifications",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Onroda nutzt die Kamera zum Scannen von Fahrt-QR-Codes (Krankenfahrt-Nachweis).",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.vedat.mobile",
          "enableGooglePay": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationAlwaysPermission": "ONRODA benötigt deinen Standort während aktiver Fahrten, auch im Hintergrund.",
          "locationAlwaysAndWhenInUsePermission": "ONRODA benötigt deinen Standort, um Fahrten zu vermitteln.",
          "locationWhenInUsePermission": "ONRODA benötigt deinen Standort für die aktuelle Fahrt.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "d26d59ac-9c12-4d1b-baa1-f30b9398cfef"
      }
    }
  }
}