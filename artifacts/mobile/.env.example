# Basis-URL der API (mit oder ohne /api — siehe utils/apiBase.ts)
# Lokal: .env setzen. EAS production/preview: eas.json. Ohne Env: Fallback api.onroda.de in utils/apiBase.ts
# EXPO_PUBLIC_API_URL=https://api.onroda.de
# Stripe Kartenzahlung (Publishable Key — Secret Key nur in API .env)
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_…

# Expo Push (Pflicht für Fahrer-Push-Token): UUID von expo.dev → Projekt „mobile“
# Nach `npx eas init` in artifacts/mobile oder aus https://expo.dev/accounts/…/projects/mobile
# EXPO_PUBLIC_EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Metro: `pnpm run dev` = fest Port 8081 (LAN, Expo Go). Nur Loopback: `pnpm run dev:localhost`.
# Replit: `pnpm run dev:replit`. app.json nicht für Ports ändern — siehe .cursor/rules/imoove-mobile-backup-expo-dev.mdc

# Google Maps (optional Override; Standard: app.json ios.config.googleMapsApiKey / android.config.googleMaps)
# Für Fahrer-Navi: Development Build oder EAS — Expo Go zeigt auf iOS oft keine Google-Kacheln.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Orte-Suche (Places API, separater Key möglich)
# EXPO_PUBLIC_GOOGLE_PLACES_KEY=
