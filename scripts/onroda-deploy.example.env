# Kopie nach scripts/onroda-deploy.env (nicht committen — in .gitignore).
# Wird von deploy-onroda-production.sh gesourced, falls vorhanden.

# --- Admin-Panel (Plattform-Admin unter admin.onroda.de/partners/) ---
# Standard-Lieferweg (ohne ONRODA_RSYNC_ADMIN_DIST_TO):
#   Deploy baut artifacts/admin-panel/dist/ → PM2 restart onroda-api → Node liefert /partners/ bei Host admin.onroda.de
#   (Nginx proxy_pass → 127.0.0.1:3000). Kein separates rsync nötig, solange Nginx nicht auf /var/www/… root zeigt.
# Optional: override API base (default in app: https://api.onroda.de/api)
# export VITE_API_BASE_URL=https://api.onroda.de/api
# Nach Deploy: Asset-Hash-Abgleich dist vs. Node (Host-Header admin.onroda.de). Optional öffentlich:
# export ONRODA_ADMIN_PANEL_VERIFY_URL=https://admin.onroda.de/partners/
# Optional Regressionsschutz (String muss im gebauten Bundle stehen):
# export ONRODA_ADMIN_PANEL_VERIFY_MARKER='Aufschläge — XL & Rollstuhl'

# Krankenfahrt: Transportschein-Fotos (`POST .../rides/:id/medical/transport-document`).
# Standard (ohne Variable): artifacts/api-server/uploads/medical-ride relativ zum API-Prozess-Arbeitsverzeichnis.
# In Produktion often ein persistenter Pfad ausserhalb des Repo-Trees:
# MEDICAL_RIDE_UPLOAD_DIR=/var/lib/onroda/medical-ride-uploads

# Git (Default: origin/main)
# GIT_REMOTE_BRANCH=origin/main

# PM2-Prozesse, nacheinander neu starten (Leerzeichen-getrennt).
# Standard: nur API (liefert Admin-/Partner-Panel statisch mit aus).
# Admin-Panel: kein PM2 — Nginx/rsync oder API-Static (siehe ecosystem.config.cjs).
# ONRODA_PM2_APPS="onroda-api"
# ONRODA_PM2_APPS="onroda-api onroda-partner-panel"

# Nur nötig, wenn Nginx (oder anderer Host) die Vite-dist-Ordner nicht per proxy_pass von Node bezieht,
# sondern statisch aus /var/www/… — dann nach dem Build synchronisieren (sonst leer lassen):
# ONRODA_RSYNC_ADMIN_DIST_TO=/var/www/admin-onroda/partners
# ONRODA_RSYNC_PARTNER_DIST_TO=/var/www/panel-onroda

# Marketing (onroda.de): Repo-Quelle artifacts/marketing-site/ → Nginx-Webroot (Standard: /var/www/onroda).
# Wird vom Deploy-Skript automatisch per rsync synchronisiert (ohne --delete).
export ONRODA_RSYNC_MARKETING_STATIC_TO=/var/www/onroda
# export ONRODA_SKIP_MARKETING_RSYNC=1
# export ONRODA_MARKETING_HOME_VERIFY_URL=https://onroda.de/
# export ONRODA_RELOAD_NGINX=1
# Öffentliche Prüfung nach Reload: Deploy bricht ab, wenn nicht die Status-HTML geliefert wird.
# ONRODA_MARKETING_STATUS_VERIFY_URL=https://www.onroda.de/partner/anfrage-status
#
# Partner-Anfrage → Freigabe-E-Mail (Erstzugang): in artifacts/api-server/.env (nicht in dieser Datei) setzen:
# PARTNER_REGISTRATION_SMTP_URL=…  und  PARTNER_REGISTRATION_MAIL_FROM=…  — siehe artifacts/api-server/.env.example.
# Ohne beides sendet die API keine Freigabe-Mail; Unternehmer erhält dann keine Zugangsdaten per E-Mail.

# Nach jedem Deploy: scripts/verify-onroda-db-schema.sql gegen DATABASE_URL (Objektliste im SQL-Skript, siehe MIGRATION_ORDER.txt).
# Nur setzen, wenn der Deploy ohne Schema-Check durchlaufen muss (Notfall — riskant).
# ONRODA_SKIP_SCHEMA_VERIFY=1

# Zusätzlicher Node-Check nach Schema-Verifikation: Partner-Registrierung → Freigabe (admin_companies INSERT),
# u. a. Spalte partner_panel_profile_locked (031) und company_kind CHECK inkl. medical (032). Siehe scripts/verify-onroda-partner-approve-db-prereqs.mjs
# ONRODA_SKIP_PARTNER_APPROVE_DB_VERIFY=1

# HTTP-Health-Checks am Ende des Deploys (curl, bricht bei Fehler ab).
# Default: eine URL http://127.0.0.1:<PORT>/api/healthz (<PORT> aus api-server/.env oder 3000).
# Zusätzlich z. B. Admin-Vite-Preview:
# ONRODA_HEALTHCHECK_URLS="http://127.0.0.1:3000/api/healthz http://127.0.0.1:3001/partners/"
# ONRODA_HEALTHCHECK_TIMEOUT=20
# ONRODA_HEALTHCHECK_INITIAL_WAIT_SECONDS=3
# ONRODA_HEALTHCHECK_RETRIES=8
# ONRODA_HEALTHCHECK_RETRY_DELAY_SECONDS=2
# ONRODA_SKIP_HEALTHCHECKS=1

# --seed-migration-tracker schreibt nur onroda_deploy_migrations, führt KEIN Migration-SQL aus.
# Ohne diese Bestätigung verweigert deploy-onroda-production.sh den Seed (verhindert Tracker≠Schema).
# ONRODA_CONFIRM_SEED_MIGRATION_TRACKER=1
